---
<main class="board">
  <header class="board__top">
    <div>
      <p class="kicker">{{ groups | length }} groups · <a href="/logos/">Mascot marks</a></p>
      <h1>Word marks</h1>
      <p class="lede">Everything so far stays on this board. The last group is for the live site: a light 56px header with no logo, a black footer, and flat ink type. These ten are wide, plain KDEENOFF, and use one color already on the page.</p>
    </div>
    <figure class="source">
      <img src="/img/logos/03-muzzle.jpg" alt="Source muzzle silhouette" width="148" height="148">
      <figcaption>Source</figcaption>
    </figure>
  </header>

  {% for group in groups %}
  <section class="band{% if group.wide %} band--wide{% endif %}" id="{{ group.id }}">
    <h2>{{ group.title }}</h2>
    <ol class="index">
      {% for mark in group.marks %}
      <li><a href="#{{ group.id }}-{{ mark.num }}">{{ mark.num }} {{ mark.title }}</a></li>
      {% endfor %}
    </ol>
    <div class="sheets">
      {% for mark in group.marks %}
      <article class="sheet" id="{{ group.id }}-{{ mark.num }}">
        <header class="sheet__top"><span class="sheet__num">{{ mark.num }}</span><h2>{{ mark.title }}</h2></header>
        <figure class="sheet__mark"><img src="/img/logos/word/{{ mark.file }}" alt="{{ mark.alt }}" width="{% if group.wide %}2000{% else %}800{% endif %}" height="{% if group.wide %}400{% else %}800{% endif %}"></figure>
        <p>{{ mark.text }}</p>
        <div class="tests" aria-hidden="true">
          <div class="test test--light">
            <img src="/img/logos/word/{{ mark.file }}" alt="" width="88" height="88">
            <img src="/img/logos/word/{{ mark.file }}" alt="" width="48" height="48">
            <img src="/img/logos/word/{{ mark.file }}" alt="" width="24" height="24">
            <span>Sizes</span>
          </div>
          {% if group.invert %}
          <div class="test test--dark">
            <img src="/img/logos/word/{{ mark.file }}" alt="" width="88" height="88">
            <span>Footer</span>
          </div>
          {% endif %}
        </div>
      </article>
      {% endfor %}
    </div>
  </section>
  {% endfor %}
</main>
