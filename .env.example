# Copy to `.env` in the repo root. `.env` is git-ignored.
# Server
PORT=8080
# Path to the SQLite file (relative to the repo root or absolute).
DATABASE_PATH=data/kdeenoff.sqlite
# "production" turns off the localhost admin bypass and the dev account route.
NODE_ENV=development
# Optional reverse proxy / static overrides:
# TRUST_PROXY=false
# FRONTEND_DIST=frontend/dist

# Site
SITE_LABEL=kdeenoff
PROMO_CODE=KDEENOFF

# Kick OAuth
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Email codes (Resend)
RESEND_API_KEY=

# Cloudflare Access (admin gate). Without Access or an admin allowlist, the admin answers 503 in production.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Optional comma-separated admin allowlists (verified emails or linked Kick usernames/IDs)
ADMIN_EMAILS=
ADMIN_KICK_USERS=

# Optional comma-separated streamer allowlists (can manage raffles without full admin access)
STREAMER_EMAILS=
STREAMER_KICK_USERS=

