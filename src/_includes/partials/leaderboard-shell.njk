{% set lbSlug = lbSlug | default("") %}
{% set lbHeading = lbHeading | default("h2") %}
{% set lbPlain = lbPlain | default(false) %}
{% set lbPodiumArt = lbPodiumArt | default(false) %}
<div class="lb" data-leaderboard-shell data-lb-slug="{{ lbSlug }}"{% if lbSwitcher %} data-lb-switcher{% endif %}{% if lbCollapse %} data-lb-collapse{% endif %} data-partner="generic">
  <header class="lb__intro section-head">
    {% if not lbCollapse %}
    <p class="eyebrow">{% if not lbPlain %}<span class="lb__dot" aria-hidden="true"></span>{% endif %}<span data-lb-partner-name>Partner</span> leaderboard</p>
    {% endif %}
    <{{ lbHeading }} class="title"><span class="accent" data-lb-pool-short>$—</span> Leaderboard</{{ lbHeading }}>
    {% if not lbCollapse %}
    <p class="lead" data-lb-subtitle>Wager under code {{ site.promoCode }} and climb the board — top spots get paid.</p>
    {% endif %}
    <div class="lb__controls">
      <div class="seg" data-lb-tabs role="tablist" aria-label="Choose leaderboard" hidden></div>
      {% if not lbCollapse %}
      <a class="btn btn--emerald btn--sm" data-lb-partner-cta href="#" target="_blank" rel="noopener noreferrer sponsored">Join <span data-lb-partner-label>partner</span></a>
      {% endif %}
    </div>
  </header>

  <div class="lb__stage" data-lb-podium>
    {% if not lbPlain %}
    <div class="lb__stage-scene" aria-hidden="true">
      <div class="stage-glow"></div>
    </div>
    {% endif %}

    <div class="countdown" data-lb-countdown role="timer" aria-label="Leaderboard ends in">
      {% if not lbPlain %}
      <div class="slot-clock">
        <img class="slot-clock__jewel" src="/img/lb/slot-gem.webp" alt="" width="960" height="459" decoding="async">
        <img class="slot-clock__lamp" src="/img/lb/slot-lamp.webp" alt="" width="1600" height="273" decoding="async">
        <div class="slot-clock__bay">
          <video class="slot-clock__host" muted loop playsinline autoplay preload="metadata" poster="/img/lb/slot-host-poster.webp" aria-hidden="true">
            <source src="/img/lb/slot-host.webm" type="video/webm">
          </video>
          <img class="slot-clock__host slot-clock__host--still" src="/img/lb/slot-host-poster.webp" alt="" width="352" height="432" decoding="async">
      {% endif %}
          <div class="countdown__cells">
            {% if not lbPlain %}<span class="slot-clock__pay" aria-hidden="true"></span>{% endif %}
            <p><strong data-cd="d">00</strong>{% if lbPlain %} {% endif %}<span>Days</span></p>
            <p><strong data-cd="h">00</strong>{% if lbPlain %} {% endif %}<span>Hrs</span></p>
            <p><strong data-cd="m">00</strong>{% if lbPlain %} {% endif %}<span>Min</span></p>
            <p><strong data-cd="s">00</strong>{% if lbPlain %} {% endif %}<span>Sec</span></p>
          </div>
      {% if not lbPlain %}
          <img class="slot-clock__lever" src="/img/cabinet/lever.webp" alt="" width="64" height="220" decoding="async">
        </div>
      </div>
      {% endif %}
    </div>

    <div class="lb__winners">
      {% for rank in [2, 1, 3] %}
      <article class="podium podium--{{ rank }} is-empty" data-podium-rank="{{ rank }}" aria-label="Place {{ rank }}">
        {% if lbPodiumArt or not lbPlain %}
        <div class="podium__art" aria-hidden="true">
          <img class="podium__deco" src="/img/lb/place-{{ rank }}.webp" alt="" width="320" height="240" loading="lazy">
        </div>
        {% endif %}
        <span class="podium__rank" aria-hidden="true">{{ rank }}</span>
        <div class="podium__who">
          <img class="podium__avatar" data-podium-avatar src="" alt="" width="40" height="40" loading="lazy">
          <h3 class="podium__name" data-podium-username>—</h3>
        </div>
        <div class="podium__stats">
          <p class="stat-box stat-box--prize"><span>Prize</span>{% if lbPlain %} {% endif %}<strong data-podium-prize>—</strong></p>
          <p class="stat-box"><span>Wagered</span>{% if lbPlain %} {% endif %}<strong data-podium-wager>—</strong></p>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>

  <div class="lb__table">
    <div class="lb-row lb-row--head" aria-hidden="true">
      <span>Place</span>
      <span>User</span>
      <span>Wagered</span>
      <span>Prize</span>
    </div>
    <ol class="lb__rows" data-lb-rows>
      <li class="lb-row lb-row--skeleton" aria-hidden="true"><span></span><span></span><span></span><span></span></li>
      <li class="lb-row lb-row--skeleton" aria-hidden="true"><span></span><span></span><span></span><span></span></li>
      <li class="lb-row lb-row--skeleton" aria-hidden="true"><span></span><span></span><span></span><span></span></li>
    </ol>
    <p class="lb__empty" data-lb-empty hidden>No players yet — be the first on the board!</p>
  </div>

  {% if not lbCollapse %}
  <footer class="lb__foot">
    <p class="lb__terms">Wagers update automatically. Abuse or multi-accounting leads to disqualification.</p>
  </footer>
  {% endif %}
</div>
