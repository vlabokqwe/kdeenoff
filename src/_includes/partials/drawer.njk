<div class="drawer-scrim" data-drawer-scrim hidden></div>
<aside class="drawer" id="drawer" aria-label="Menu and leaderboards">
  <div class="drawer__scroll">
    <div class="drawer__group">
      <nav class="drawer__nav" aria-label="Sections">
        <a href="/raffles/" class="drawer-link" data-nav-link="raffles"><img src="/img/icons/nav-raffle.webp" alt="" width="18" height="18"><span>Raffles</span></a>
        <a href="/bonuses/" class="drawer-link" data-nav-link="bonus"><img src="/img/icons/nav-gift.webp" alt="" width="18" height="18"><span>Bonuses</span></a>
        <a href="/account/" class="drawer-link" data-nav-link="kick"><img src="/img/brand/kick-logo-k.svg" alt="" width="18" height="18"><span>Account</span></a>
      </nav>
    </div>

    <section class="drawer__group drawer__boards" data-side-boards-wrap aria-label="Leaderboard">
      <div class="drawer__boards-list" data-side-boards>
        <span class="side-board side-board--skeleton" aria-hidden="true"></span>
      </div>
    </section>

    <div class="drawer__group">
      <a href="/#contacts" class="drawer-link" data-nav-link="contacts"><img src="/img/icons/nav-chat.webp" alt="" width="18" height="18"><span>Contacts</span></a>
    </div>
  </div>

  <div class="drawer__foot">
    <section class="drawer__group drawer__theme" aria-label="Appearance">
      <p class="drawer__label drawer__label--quiet">Appearance</p>
      <div class="theme-switch" role="group" aria-label="Site theme">
        <button type="button" class="theme-switch__btn" data-theme-choice="light" aria-pressed="true">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1.15a.7.7 0 0 1 .7.7V3.1a.7.7 0 1 1-1.4 0V1.85a.7.7 0 0 1 .7-.7Zm0 9.2a2.55 2.55 0 1 0 0-5.1 2.55 2.55 0 0 0 0 5.1ZM3.22 3.22a.7.7 0 0 1 .99 0l.9.9a.7.7 0 1 1-.99.99l-.9-.9a.7.7 0 0 1 0-.99Zm7.67.9.9-.9a.7.7 0 1 1 .99.99l-.9.9a.7.7 0 0 1-.99-.99ZM1.15 8a.7.7 0 0 1 .7-.7h1.25a.7.7 0 1 1 0 1.4H1.85A.7.7 0 0 1 1.15 8Zm10.75 0a.7.7 0 0 1 .7-.7h1.25a.7.7 0 1 1 0 1.4h-1.25a.7.7 0 0 1-.7-.7ZM4.21 10.8a.7.7 0 0 1 0 .99l-.9.9a.7.7 0 0 1-.99-.99l.9-.9a.7.7 0 0 1 .99 0Zm7.58 0a.7.7 0 0 1 .99 0l.9.9a.7.7 0 0 1-.99.99l-.9-.9a.7.7 0 0 1 0-.99ZM8 12.9a.7.7 0 0 1 .7.7v1.25a.7.7 0 1 1-1.4 0V13.6a.7.7 0 0 1 .7-.7Z"/></svg>
          <span>Light</span>
        </button>
        <button type="button" class="theme-switch__btn" data-theme-choice="dark" aria-pressed="false">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8.55 1.35a.75.75 0 0 1 .18.86 4.35 4.35 0 0 0 4.96 5.55.75.75 0 0 1 .62.98A6.55 6.55 0 1 1 7.7 1.15a.75.75 0 0 1 .85.2Z"/></svg>
          <span>Dark</span>
        </button>
      </div>
    </section>

    <section class="drawer__group drawer__refer" aria-label="Referral link">
      <p class="drawer__label drawer__label--quiet">Referral</p>
      <button type="button" class="drawer-link drawer-refer" data-copy="{{ site.referralUrl or site.partners[0].url }}" aria-label="Copy referral link">
        <img src="/img/icons/nav-copy.webp" alt="" width="18" height="18">
        <span data-copy-status>Copy link</span>
      </button>
    </section>
  </div>
</aside>
