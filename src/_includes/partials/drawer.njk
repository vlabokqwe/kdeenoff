<div class="drawer-scrim" data-drawer-scrim hidden></div>
<aside class="drawer" id="drawer" aria-label="Menu and leaderboards">
  <div class="drawer__bar">
    <button type="button" class="drawer__burger" data-drawer-toggle aria-controls="drawer" aria-expanded="false" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
    <a href="/" class="drawer__brand" aria-label="KDeenOff home">
      <img src="/img/brand/mark.webp" alt="" width="36" height="36">
      <img class="drawer__word" src="/img/brand/logo.webp" alt="KDeenOff" width="140" height="38">
    </a>
  </div>

  <nav class="drawer__group" aria-label="Sections">
    <a href="/" class="drawer-link" data-nav-link="home"><img src="/img/icons/nav-home.webp" alt="" width="18" height="18"><span>Home</span></a>
    <a href="/raffles/" class="drawer-link" data-nav-link="raffles"><img src="/img/icons/nav-raffle.webp" alt="" width="18" height="18"><span>Raffles</span></a>
    <a href="/#bonus" class="drawer-link" data-nav-link="bonus"><img src="/img/icons/nav-gift.webp" alt="" width="18" height="18"><span>Bonuses</span></a>
    <a href="/#contacts" class="drawer-link" data-nav-link="contacts"><img src="/img/icons/nav-chat.webp" alt="" width="18" height="18"><span>Contacts</span></a>
  </nav>

  <section class="drawer__group drawer__boards" data-side-boards-wrap aria-labelledby="drawer-boards-title">
    <h2 class="drawer__kicker" id="drawer-boards-title">
      <img src="/img/icons/nav-trophy.webp" alt="" width="18" height="18">
      <span>Leaderboards</span>
    </h2>
    <div class="drawer__boards-list" data-side-boards>
      <span class="side-board side-board--skeleton" aria-hidden="true"></span>
    </div>
  </section>

  <div class="drawer__group drawer__foot">
    <p class="drawer__label">Promo code</p>
    <button type="button" class="code-pill code-pill--block" data-copy="{{ site.promoCode }}" aria-label="Copy promo code {{ site.promoCode }}">
      <img src="/img/icons/nav-copy.webp" alt="" width="18" height="18">
      <span class="code-pill__value">{{ site.promoCode }}</span>
      <span class="code-pill__toast" data-copy-status aria-live="polite"></span>
    </button>
    <a href="/admin/" class="drawer__admin">Admin</a>
  </div>
</aside>
