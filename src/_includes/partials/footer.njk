<footer class="footer" role="contentinfo">
  <div class="container footer__inner">
    <div class="footer__brand">
      <div class="footer__lead">
        <div class="footer__art" aria-hidden="true">
          <img class="footer__deco" src="/img/footer/mark.webp" alt="" width="742" height="826" loading="lazy">
        </div>
        <p>{{ site.tagline }}</p>
      </div>
      <div class="footer__social">
        {% if site.kickUrl %}<a href="{{ site.kickUrl }}" target="_blank" rel="noopener noreferrer" aria-label="Kick"><img class="footer__kick" src="/img/brand/kick-logo-k.svg" alt="" width="26" height="26"></a>{% endif %}
        {% if site.telegramUrl %}<a href="{{ site.telegramUrl }}" target="_blank" rel="noopener noreferrer" aria-label="Telegram"><img src="/img/icons/nav-telegram.webp" alt="" width="40" height="40" loading="lazy"></a>{% endif %}
      </div>
    </div>

    <nav class="footer__col" aria-label="Site">
      <p class="footer__title">Site</p>
      <a href="/">Home</a>
      <a href="/raffles/">Raffles</a>
      <a href="/leaderboards/">Leaderboards</a>
      <a href="/bonuses/">Bonuses</a>
    </nav>

    <nav class="footer__col" aria-label="Community">
      <p class="footer__title">Community</p>
      {% if site.kickUrl %}<a href="{{ site.kickUrl }}" target="_blank" rel="noopener noreferrer">Kick</a>{% endif %}
      {% if site.telegramUrl %}<a href="{{ site.telegramUrl }}" target="_blank" rel="noopener noreferrer">Telegram</a>{% endif %}
      <a href="/#contacts">Contacts</a>
    </nav>
  </div>

  <div class="container footer__bottom">
    <p>&copy; {% year %} KDeenOff. All rights reserved.</p>
    <p class="footer__rg">
      <img src="/img/icons/nav-18.webp" alt="18+" width="32" height="32" loading="lazy">
      <span>Gamble responsibly — <a href="https://www.begambleaware.org" target="_blank" rel="noopener noreferrer">begambleaware.org</a></span>
    </p>
  </div>
</footer>
