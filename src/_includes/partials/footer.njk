<footer class="footer" role="contentinfo">
  <div class="container footer__inner">
    <div class="footer__brand">
      <a href="/" class="footer__logo" aria-label="KDeenOff home">
        <img src="/img/brand/mark.webp" alt="" width="44" height="44" loading="lazy">
        <img src="/img/brand/logo.webp" alt="KDeenOff" width="160" height="44" loading="lazy">
      </a>
      <p>{{ site.tagline }}</p>
      <div class="footer__social">
        {% if site.kickUrl %}<a href="{{ site.kickUrl }}" target="_blank" rel="noopener noreferrer" aria-label="Kick"><img src="/img/icons/nav-kick.webp" alt="" width="44" height="44" loading="lazy"></a>{% endif %}
        {% if site.telegramUrl %}<a href="{{ site.telegramUrl }}" target="_blank" rel="noopener noreferrer" aria-label="Telegram"><img src="/img/icons/nav-telegram.webp" alt="" width="44" height="44" loading="lazy"></a>{% endif %}
      </div>
    </div>

    <nav class="footer__col" aria-label="Site">
      <p class="footer__title">Site</p>
      <a href="/">Home</a>
      <a href="/raffles/">Raffles</a>
      <a href="/leaderboards/">Leaderboards</a>
      <a href="/#bonus">Bonuses</a>
    </nav>

    <nav class="footer__col" aria-label="Community">
      <p class="footer__title">Community</p>
      {% if site.kickUrl %}<a href="{{ site.kickUrl }}" target="_blank" rel="noopener noreferrer">Kick</a>{% endif %}
      {% if site.telegramUrl %}<a href="{{ site.telegramUrl }}" target="_blank" rel="noopener noreferrer">Telegram</a>{% endif %}
      <a href="/#contacts">Contacts</a>
    </nav>
  </div>

  <div class="container footer__bottom">
    <p>&copy; {% year %} KDeenOff. All rights reserved.</p>
    <p class="footer__rg">
      <img src="/img/icons/nav-18.webp" alt="18+" width="32" height="32" loading="lazy">
      <span>Gamble responsibly — <a href="https://www.begambleaware.org" target="_blank" rel="noopener noreferrer">begambleaware.org</a></span>
    </p>
  </div>
</footer>
