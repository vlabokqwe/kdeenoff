<!DOCTYPE html>
<html lang="{{ site.lang | default('en') }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ site.tagline }}">
  <meta name="theme-color" content="#0c1218">
  <script>
    (function () {
      var theme = "dark";
      try {
        var stored = localStorage.getItem("kdeenoff-theme-v2");
        if (stored === "dark" || stored === "light") theme = stored;
      } catch (e) {}
      document.documentElement.setAttribute("data-theme", theme);
      var meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute("content", theme === "dark" ? "#0c1218" : "#f7f7f7");
    })();
  </script>
  <link rel="icon" href="/img/brand/mark-cards.webp" type="image/webp">
  <link rel="preload" href="/fonts/rubik-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/fonts.css">
  <link rel="stylesheet" href="/css/main.css">
</head>
<body class="site{% if pageClass %} {{ pageClass }}{% endif %}">
  {% if site.kickChannel %}
  <script>
    (function () {
      var open = true;
      try {
        var stored = localStorage.getItem("kdeenoff-chat");
        if (stored === "0" || stored === "1") open = stored === "1";
        else open = matchMedia("(min-width: 1041px)").matches;
      } catch (e) {}
      document.body.classList.toggle("chat-open", open);
    })();
  </script>
  {% endif %}
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="topbar">
    <div class="topbar__start">
      <button type="button" class="topbar__menu" data-drawer-toggle aria-controls="drawer" aria-expanded="false" aria-label="Open menu">
        <img src="/img/icons/nav-menu.webp" alt="" width="16" height="16">
      </button>
      <a class="topbar__mark" href="/" aria-label="KDeenOff home">
        <img src="/img/brand/mark-muzzle.png" alt="" width="37" height="26">
        <span class="topbar__word">KDEENOFF</span>
      </a>
    </div>
    <div class="topbar__auth">
      <a class="topbar__kick" href="/account/" data-kick-account aria-label="Account">
        <img src="/img/brand/kick-logo-k.svg" alt="" width="14" height="14">
        <span data-kick-account-label>Kick</span>
      </a>
      <button type="button" class="topbar__login" data-auth-open="login">Login</button>
      <button type="button" class="topbar__register" data-auth-open="register">Register</button>
    </div>
  </header>

  {% include "partials/drawer.njk" %}

  <main id="main" class="main">
    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}

  {% if site.kickChannel %}
  <aside class="kick-chat" id="kick-chat" data-kick-channel="{{ site.kickChannel }}" aria-label="Kick chat">
    <header class="kick-chat__bar">
      <button type="button" class="kick-chat__hide" data-kick-chat-toggle aria-expanded="true" aria-controls="kick-chat-log" aria-label="Hide chat">
        <span class="kick-chat__chev" aria-hidden="true"></span>
      </button>
    </header>
    <div class="kick-chat__log" id="kick-chat-log" data-kick-chat-log tabindex="0">
      <p class="kick-chat__status">Loading chat…</p>
    </div>
    <button type="button" class="kick-chat__show" data-kick-chat-toggle aria-expanded="false" aria-controls="kick-chat-log" aria-label="Show chat">
      <img src="/img/brand/kick-logo-k.svg" alt="" width="24" height="24">
    </button>
  </aside>
  {% endif %}

  <dialog class="auth-dialog" data-auth-dialog aria-labelledby="auth-dialog-title">
    <div class="auth-dialog__card">
      <header class="auth-dialog__head">
        <h2 id="auth-dialog-title" data-auth-title>Create your account</h2>
        <button type="button" class="auth-dialog__close" data-auth-close aria-label="Close">×</button>
      </header>
      <p class="auth-dialog__sub" data-auth-sub>We'll email you a code.</p>
      <p class="auth-dialog__error" data-auth-error hidden></p>
      <p class="auth-dialog__done" data-auth-done hidden></p>
      <form class="auth-dialog__form" data-auth-email hidden>
        <label class="auth-dialog__field">Email address
          <input type="email" name="email" autocomplete="email" required maxlength="254" data-auth-email-input>
        </label>
        <button type="submit" class="auth-dialog__submit" data-auth-send>Send code</button>
      </form>
      <form class="auth-dialog__form" data-auth-code hidden>
        <label class="auth-dialog__field">Code from your email
          <input type="text" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]{6}" required data-auth-code-input>
        </label>
        <button type="submit" class="auth-dialog__submit" data-auth-confirm>Confirm</button>
        <button type="button" class="auth-dialog__back" data-auth-back>Use a different email</button>
      </form>
      <a class="auth-dialog__account" href="/account/" data-auth-account hidden>Open your account</a>
    </div>
  </dialog>

  <script type="module" src="/js/main.js"></script>
  <script type="module" src="/js/leaderboard.js"></script>
</body>
</html>
