---
layout: layout.njk
title: Home
permalink: /
pageClass: site--home
---
{% set perkIcons = { "deposit": "/img/icons/nav-deposit.webp", "rakeback": "/img/icons/nav-rakeback.webp", "leaderboard": "/img/icons/nav-trophy.webp", "vip": "/img/icons/nav-vip.webp", "spins": "/img/icons/nav-spins.webp" } %}

{# ───────────── 1. HERO ───────────── #}
<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero__bg" aria-hidden="true"></div>
  <div class="container hero__inner">
    {% if site.kickChannel %}
    <div class="hero__player">
      <iframe
        src="https://player.kick.com/{{ site.kickChannel }}?autoplay=true&muted=true"
        title="KDeenOff live on Kick"
        allow="autoplay; fullscreen; picture-in-picture"
        allowfullscreen
      ></iframe>
    </div>
    {% endif %}
    <div class="hero__copy">
      <h1 class="hero__title" id="hero-title">Play with code <button type="button" class="accent hero__codeword" data-copy="{{ site.promoCode }}" aria-label="Copy promo code {{ site.promoCode }}"><span data-copy-status>{{ site.promoCode }}</span></button></h1>

    </div>

    <div class="modes">
      <a class="mode mode--raffle" href="/raffles/">
        <img src="/img/deco/mode-raffle.webp" alt="" width="420" height="420">
        <span>Raffles</span>
      </a>
      <button type="button" class="mode mode--boards" data-open-boards aria-controls="drawer">
        <img src="/img/deco/mode-boards.webp" alt="" width="420" height="420">
        <span>Leaderboards</span>
      </button>
      <a class="mode mode--bonus" href="/#bonus">
        <img src="/img/deco/mode-bonus.webp" alt="" width="420" height="420">
        <span>Bonuses</span>
      </a>
    </div>

  </div>
  <a class="hero__scroll" href="#steps-title"><span>Start earning <span class="accent">rewards</span></span></a>
</section>

{# ───────────── TRANSITION: RAFFLE STEPS ───────────── #}
{% include "partials/steps.njk" %}

{# ───────────── 2. BONUS ───────────── #}
<section class="bonus" id="bonus" aria-labelledby="bonus-title">
  <div class="bonus__bg" aria-hidden="true"></div>
  <div class="container">
    <header class="section-head">
      <h2 class="title" id="bonus-title">Claim your <span class="accent">bonus</span></h2>
      <p class="lead">Sign up through our partner links with code <strong>{{ site.promoCode }}</strong> — every partner has its own rewards and terms.</p>
    </header>

    {% if site.partners | length > 1 %}
    <div class="seg seg--center" role="tablist" aria-label="Choose partner" data-partner-tabs>
      {% for p in site.partners %}
      <button type="button" role="tab" class="seg__btn" data-partner-tab="{{ p.id }}" aria-selected="{{ 'true' if loop.first else 'false' }}">{{ p.name }}</button>
      {% endfor %}
    </div>
    {% endif %}

    <div class="bonus__cards">
      {% for p in site.partners %}
      <article class="partner-card" data-partner="{{ p.theme | default('generic') }}" data-partner-panel="{{ p.id }}"{% if not loop.first %} hidden{% endif %} data-reveal>
        <div class="partner-card__bg" aria-hidden="true"></div>
        <div class="partner-card__body">
          <p class="partner-card__brand">{{ p.name }}</p>
          <h3 class="partner-card__title">
            Sign up under
            <button type="button" class="code-pill" data-copy="{{ p.code or site.promoCode }}" aria-label="Copy code {{ p.code or site.promoCode }}">
              <img src="/img/icons/nav-copy.webp" alt="" width="20" height="20">
              <span class="code-pill__value">{{ p.code or site.promoCode }}</span>
              <span class="code-pill__toast" data-copy-status aria-live="polite"></span>
            </button>
          </h3>
          <p class="partner-card__lead">{{ p.headline }}</p>

          <ul class="perks">
            {% for b in p.bonuses %}
            <li class="perk">
              <img src="{{ perkIcons[b.type] or '/img/icons/nav-star.webp' }}" alt="" width="44" height="44" loading="lazy">
              <span><strong>{{ b.value }}</strong> {{ b.label }}</span>
            </li>
            {% endfor %}
          </ul>

          {% if p.conditions and p.conditions.length %}
          <ul class="terms" aria-label="Terms">
            {% for c in p.conditions %}
            <li><img src="/img/icons/nav-star.webp" alt="" width="18" height="18" loading="lazy"><span>{{ c }}</span></li>
            {% endfor %}
          </ul>
          {% endif %}

          <a class="btn btn--partner" href="{{ p.url }}" target="_blank" rel="noopener noreferrer sponsored">{{ p.cta or "Claim bonus" }}</a>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

{# ───────────── 3. LEADERBOARD ───────────── #}
<section class="board-section" id="leaderboard" aria-label="Leaderboard">
  <div class="board-section__bg" aria-hidden="true"></div>
  {% set lbSlug = "" %}
  {% set lbSwitcher = true %}
  {% set lbCollapse = true %}
  {% set lbHeading = "h2" %}
  {% include "partials/leaderboard-shell.njk" %}
</section>

{# ───────────── 4. CONTACTS ───────────── #}
<section class="contacts" id="contacts" aria-labelledby="contacts-title">
  <div class="contacts__bg" aria-hidden="true"></div>
  <div class="container contacts__inner">
    <div class="contacts__copy">
      <header class="section-head section-head--left">
        <h2 class="title" id="contacts-title">Join the <span class="accent">community</span></h2>
        <p class="lead">Giveaways, code drops and stream alerts — we post them here first.</p>
      </header>

      <div class="contacts__grid">
        {% if site.telegramUrl %}
        <a class="contact-card" href="{{ site.telegramUrl }}" target="_blank" rel="noopener noreferrer" data-reveal>
          <img src="/img/icons/nav-telegram.webp" alt="" width="72" height="72" loading="lazy">
          <strong>Telegram</strong>
          <span>News, raffle alerts &amp; support</span>
          <span class="btn btn--sm btn--tg">Join</span>
        </a>
        {% endif %}
        {% if site.kickUrl %}
        <a class="contact-card" href="{{ site.kickUrl }}" target="_blank" rel="noopener noreferrer" data-reveal>
          <img src="/img/icons/nav-kick.webp" alt="" width="72" height="72" loading="lazy">
          <strong>Kick</strong>
          <span>Watch the stream live</span>
          <span class="btn btn--sm btn--kick">Watch</span>
        </a>
        {% endif %}
      </div>
    </div>
  </div>
</section>
