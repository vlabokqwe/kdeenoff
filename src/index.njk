---
layout: layout.njk
title: Home
permalink: /
pageClass: site--home
---
{# ───────────── 1. HERO ───────────── #}
<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero__bg" aria-hidden="true"></div>
  <div class="container hero__inner">
    {% if site.kickChannel %}
    <div class="hero__player">
      <iframe
        src="https://player.kick.com/{{ site.kickChannel }}?autoplay=true&muted=true"
        title="KDeenOff live on Kick"
        allow="autoplay; fullscreen; picture-in-picture"
        allowfullscreen
      ></iframe>
    </div>
    {% endif %}
    <div class="hero__copy">
      <h1 class="hero__title" id="hero-title">Play with code <button type="button" class="accent hero__codeword" data-copy="{{ site.promoCode }}" aria-label="Copy promo code {{ site.promoCode }}"><span data-copy-status>{{ site.promoCode }}</span></button></h1>

    </div>

    <div class="modes">
      <a class="mode mode--raffle" href="/raffles/">
        <video muted playsinline preload="auto" aria-hidden="true" poster="/img/deco/raffle-burst.webp" src="/img/deco/raffle-burst.mp4"></video>
        <span>Raffles</span>
      </a>
      <a class="mode mode--bonus" href="/bonuses/">
        <video muted playsinline preload="auto" aria-hidden="true" poster="/img/deco/bonus-burst.webp" src="/img/deco/bonus-burst.mp4"></video>
        <span>Bonuses</span>
      </a>
      <section class="lb-dash" aria-label="Leaderboards">
        <video class="lb-dash__live" muted loop playsinline autoplay preload="auto" aria-hidden="true" poster="/img/deco/dash-live.webp" src="/img/deco/dash-live.mp4"></video>
        <div class="lb-dash__list" data-lb-dash>
          <p class="lb-dash__empty">Loading leaderboards…</p>
        </div>
      </section>
    </div>

  </div>
  <a class="hero__scroll" href="#steps-title"><span>Start earning <span class="accent">rewards</span></span></a>
</section>

{# ───────────── TRANSITION: RAFFLE STEPS ───────────── #}
{% include "partials/steps.njk" %}

{# ───────────── 2. BONUS ───────────── #}
<section class="bonus" id="bonus" aria-labelledby="bonus-title">
  <div class="bonus__bg" aria-hidden="true"></div>
  <div class="container">
    <header class="section-head">
      <h2 class="title" id="bonus-title">Claim your <span class="accent">bonus</span></h2>
    </header>

    <div class="bonus__layout">
      <div class="bonus__cards">
        {% for p in site.partners %}
        <article class="partner-card" data-partner="{{ p.theme | default('generic') }}" data-reveal>
          {% if p.scene %}
          <img class="partner-card__bg" src="{{ p.scene }}" alt="" width="1600" height="900">
          <div class="partner-card__veil" aria-hidden="true"></div>
          {% endif %}
          {% if p.mascot %}
          <div class="partner-card__mascot" aria-hidden="true">
            <img src="{{ p.mascot }}" alt="" width="720" height="960">
            {% if p.mascotVideo %}
            <video muted loop playsinline preload="none" poster="{{ p.mascot }}" src="{{ p.mascotVideo }}"></video>
            {% endif %}
          </div>
          {% endif %}
          <div class="partner-card__copy">
            <h3 class="partner-card__name">
              {% if p.logo %}
              <img src="{{ p.logo }}" alt="{{ p.name }}" width="760" height="430">
              {% else %}
              {{ p.name }}
              {% endif %}
            </h3>
            <div class="partner-card__actions">
              <button type="button" class="partner-card__code" data-copy="{{ p.code or site.promoCode }}" aria-label="Copy code {{ p.code or site.promoCode }}">
                <img src="/img/icons/nav-copy.webp" alt="" width="28" height="28">
                <span class="partner-card__code-copy">
                  <span class="partner-card__code-kicker">Referral code</span>
                  <span class="partner-card__code-value">{{ p.code or site.promoCode }}</span>
                </span>
                <span class="partner-card__code-toast" data-copy-status aria-live="polite"></span>
              </button>
              <a class="partner-card__go" href="{{ p.url }}" target="_blank" rel="noopener noreferrer sponsored">
                <span class="partner-card__go-label">{{ p.cta or "Claim bonus" }}</span>
              </a>
            </div>
          </div>
        </article>
        {% endfor %}
      </div>

    </div>
  </div>
</section>

{# ───────────── 3. LEADERBOARD ───────────── #}
<section class="board-section" id="leaderboard" aria-label="Leaderboard">
  {% set lbSlug = "" %}
  {% set lbSwitcher = true %}
  {% set lbCollapse = true %}
  {% set lbHeading = "h2" %}
  {% set lbPlain = true %}
  {% set lbPodiumArt = true %}
  {% include "partials/leaderboard-shell.njk" %}
</section>

{# ───────────── 4. CONTACTS ───────────── #}
<section class="contacts" id="contacts" aria-labelledby="contacts-title">
  <div class="contacts__bg" aria-hidden="true"></div>
  <div class="container contacts__inner">
    <header class="section-head">
      <h2 class="title" id="contacts-title">Join the <span class="accent">community</span></h2>
      <p class="lead">Giveaways, code drops and stream alerts — we post them here first.</p>
    </header>

    <div class="contacts__grid">
      {% if site.telegramUrl %}
      <a class="contact-card" href="{{ site.telegramUrl }}" target="_blank" rel="noopener noreferrer" data-reveal>
        <span class="contact-card__art" aria-hidden="true">
          <img class="contact-card__deco" src="/img/contacts/telegram.webp" alt="" width="320" height="240" loading="lazy">
        </span>
        <span class="contact-card__copy">
          <strong>Telegram</strong>
          <span>News, raffle alerts &amp; support</span>
          <span class="btn btn--sm">Join</span>
        </span>
      </a>
      {% endif %}
      {% if site.kickUrl %}
      <a class="contact-card" href="{{ site.kickUrl }}" target="_blank" rel="noopener noreferrer" data-reveal>
        <span class="contact-card__art" aria-hidden="true">
          <img class="contact-card__deco" src="/img/contacts/kick.webp" alt="" width="320" height="240" loading="lazy">
        </span>
        <span class="contact-card__copy">
          <strong>Kick</strong>
          <span>Watch the stream live</span>
          <span class="btn btn--sm">Watch</span>
        </span>
      </a>
      {% endif %}
    </div>
  </div>
</section>
