---
layout: layout.njk
title: Bonuses
permalink: /bonuses/
pageClass: site--bonuses
---
{% set partner = site.partners[0] %}
{% set claimSteps = [
  { title: "Create the account", art: "/img/steps/register.webp", tint: "indigo" },
  { title: "Enter the code", art: "/img/steps/code.webp", tint: "sky" },
  { title: "Make the deposit", art: "/img/deco/mode-bonus.webp", tint: "coral" }
] %}

<section class="bonus-hero" aria-labelledby="bonus-title">
  <div class="container bonus-hero__stage">
    <div class="bonus-hero__copy">
      <h2 class="title" id="bonus-title">Claim your <span class="accent">bonus</span></h2>
      {% if partner %}
      <div class="bonus-hero__actions">
        <button type="button" class="bonus-code" data-copy="{{ partner.code or site.promoCode }}" aria-label="Copy code {{ partner.code or site.promoCode }}">
          <img src="/img/icons/nav-copy.webp" alt="" width="22" height="22">
          <span class="bonus-code__value">{{ partner.code or site.promoCode }}</span>
          <span class="bonus-code__toast" data-copy-status aria-live="polite"></span>
        </button>
        <a class="bonus-go" href="{{ partner.url }}" target="_blank" rel="noopener noreferrer sponsored">{{ partner.cta or "Claim bonus" }}</a>
      </div>
      {% endif %}
    </div>
  </div>
</section>

{% if partner and partner.conditions %}
<section class="bonus-path" aria-labelledby="bonus-steps-title">
  <div class="container">
    <header class="section-head section-head--left">
      <h2 class="title" id="bonus-steps-title">How to <span class="accent">claim</span></h2>
      <p class="lead">Three checks, then the bonus is yours.</p>
    </header>

    <ol class="bonus-steps">
      {% for condition in partner.conditions %}
      {% set meta = claimSteps[loop.index0] %}
      <li class="bonus-step bonus-step--{{ meta.tint if meta else 'indigo' }}">
        <div class="bonus-step__art">
          <img src="{{ meta.art if meta else '/img/icons/nav-gift.webp' }}" alt="" width="240" height="180">
        </div>
        <p class="bonus-step__num">Step {{ loop.index }}</p>
        <h3 class="bonus-step__title">{{ meta.title if meta else "Claim" }}</h3>
        <p class="bonus-step__text">{{ condition }}</p>
      </li>
      {% endfor %}
    </ol>
  </div>
</section>
{% endif %}
